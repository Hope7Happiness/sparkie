# Copy to .env; the CLI loads it without overriding exported variables.
DEEPGRAM_API_KEY=
DEEPGRAM_MODEL=nova-3
# Use zh-CN for Mandarin; en for an English demo. Test codeswitching separately.
DEEPGRAM_LANGUAGE=zh-CN
DEEPGRAM_TTS_MODEL=aura-2-thalia-en
# Deepgram TTS does not currently list Chinese support; STT language is independent.
SPARKIE_REPLY="I'm here."
# Optional device index or unique name; list with `sparkie devices`.
SPARKIE_INPUT_DEVICE=
SPARKIE_OUTPUT_DEVICE=

# Optional: for the next-stage OpenAI brain. Choose a model enabled for your project.
OPENAI_API_KEY=
OPENAI_MODEL=
SPARKIE_BACKEND=codex
# Codex uses existing CLI login. Empty model uses the CLI default.
CODEX_MODEL=
CODEX_TIMEOUT_SECONDS=120

# Meeting SDK credentials, not Server-to-Server OAuth credentials.
ZOOM_CLIENT_ID=
ZOOM_CLIENT_SECRET=
ZOOM_MEETING_ID=
ZOOM_MEETING_PASSWORD=
# Optional for internal account testing; external meetings require approved authorization.
ZOOM_ZAK=
ZOOM_OBF_TOKEN=
# Absolute path to the extracted Linux SDK containing h/ and libmeetingsdk.so.
ZOOM_SDK_PATH=
