# Copy to .env; the CLI loads it without overriding exported variables.
# Current setup: macOS Zoom, en-US, Realtime voice, Devin tasks and Gemini wake routing.
# Fill in your own credentials, meeting details and local SDK path below.
DEEPGRAM_API_KEY=
DEEPGRAM_MODEL=nova-3
# Use en-US for runs and demos.
DEEPGRAM_LANGUAGE=en-US
DEEPGRAM_TTS_MODEL=aura-2-thalia-en
# Deepgram TTS does not currently list Chinese support; STT language is independent.
SPARKIE_REPLY="I'm here."
SPARKIE_QUESTION_REPLY="Let me think for a moment."
# Optional device index or unique name; list with `sparkie devices`.
SPARKIE_INPUT_DEVICE=
SPARKIE_OUTPUT_DEVICE=

# Required for the Realtime voice frontend; keys stay in the Python process.
OPENAI_API_KEY=
OPENAI_REALTIME_MODEL=gpt-realtime-2.1
# Realtime background tasks: devin in this setup; codex is also supported.
# Both reuse their CLI login.
SPARKIE_TASK_BACKEND=devin
# Devin CLI model UID; run `devin auth login` and `devin models list`.
DEVIN_MODEL=swe-1-6-fast
# Zoom-only semantic wake/reply routing through a separate tool-free Devin process.
# Set rules to restore the local wake policy.
SPARKIE_WAKE_ROUTER=devin
SPARKIE_WAKE_MODEL=gemini-3-5-flash-minimal
# Zoom per-participant speech completion: semantic_vad (medium eagerness) or legacy deepgram.
# Eagerness is currently set in code, not through an environment variable.
# Semantic mode adds a separate Realtime audio detector for each active human speaker.
SPARKIE_TURN_DETECTION=semantic_vad
# macOS Zoom STT concurrency, including streams being finalized (1-64).
SPARKIE_ZOOM_MAX_STT_STREAMS=32
# Legacy CLI OpenAI reasoning backend (optional):
OPENAI_MODEL=gpt-5.6-sol
# The legacy CLI path below is separate from the active Realtime task backend above.
SPARKIE_BACKEND=codex
# Codex uses existing CLI login. Defaults are pinned for the voice Q&A workload.
CODEX_MODEL=gpt-5.6-terra
CODEX_REASONING_EFFORT=medium
CODEX_TIMEOUT_SECONDS=120

# Meeting SDK credentials, not Server-to-Server OAuth credentials.
ZOOM_CLIENT_ID=
ZOOM_CLIENT_SECRET=
ZOOM_MEETING_ID=
ZOOM_MEETING_PASSWORD=
# Optional for internal account testing; external meetings require approved authorization.
ZOOM_ZAK=
ZOOM_OBF_TOKEN=
# macos uses a native app; linux selects the Docker workflow.
ZOOM_PLATFORM=macos
# Linux: directory containing h/ and libmeetingsdk.so.
# macOS fallback: extracted root containing ZoomSDK/ZoomSDK.framework.
ZOOM_SDK_PATH=

# Set your own extracted macOS SDK path; this is machine-specific.
# Keeps ZOOM_SDK_PATH available for Linux.
ZOOM_MACOS_SDK_PATH=
