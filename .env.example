# Copy to .env; the CLI loads it without overriding exported variables.
DEEPGRAM_API_KEY=
DEEPGRAM_MODEL=nova-3
# Use zh-CN for Mandarin; en for an English demo. Test codeswitching separately.
DEEPGRAM_LANGUAGE=zh-CN
DEEPGRAM_TTS_MODEL=aura-2-thalia-en
# Deepgram TTS does not currently list Chinese support; STT language is independent.
SPARKIE_REPLY="I'm here."
SPARKIE_QUESTION_REPLY="Let me think for a moment."
# Optional device index or unique name; list with `sparkie devices`.
SPARKIE_INPUT_DEVICE=
SPARKIE_OUTPUT_DEVICE=

# Optional alternative to the default Codex reasoning backend.
OPENAI_API_KEY=
OPENAI_MODEL=
SPARKIE_BACKEND=codex
# Codex uses existing CLI login. Defaults are pinned for the voice Q&A workload.
CODEX_MODEL=gpt-5.6-terra
CODEX_REASONING_EFFORT=medium
CODEX_TIMEOUT_SECONDS=120

# Meeting SDK credentials, not Server-to-Server OAuth credentials.
ZOOM_CLIENT_ID=
ZOOM_CLIENT_SECRET=
ZOOM_MEETING_ID=
ZOOM_MEETING_PASSWORD=
# Optional for internal account testing; external meetings require approved authorization.
ZOOM_ZAK=
ZOOM_OBF_TOKEN=
# linux (default) preserves the existing Docker workflow; macos uses a native app.
ZOOM_PLATFORM=linux
# Linux: directory containing h/ and libmeetingsdk.so.
# macOS fallback: extracted root containing ZoomSDK/ZoomSDK.framework.
ZOOM_SDK_PATH=

# Optional macOS-specific path; keeps ZOOM_SDK_PATH available for Linux.
ZOOM_MACOS_SDK_PATH=
